{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "앱 화면·미니 플레이어: 엔진 요청·상태 조회·로그인 창 열기, 이벤트 듣기, 외부 링크 열기, 테마에 맞춘 창 제목 막대·바탕색, 차트 곡 목록 읽기, 영상 창·미니 플레이어·알림·전역 단축키 설정, 전체 화면 모드(창 전체 화면·화면 꺼짐 막기).",
  "windows": [
    "main",
    "mini"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "opener:default",
    "allow-engine-call",
    "allow-get-engine-status",
    "allow-get-player-state",
    "allow-show-engine",
    "allow-hide-engine",
    "allow-spotify-playlist",
    "allow-chart-fetch",
    "allow-ui-log",
    "allow-eq-set",
    "allow-eq-visualizer",
    "allow-video-window",
    "allow-mini-window",
    "allow-mini-pin",
    "allow-keep-awake",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-set-prefs",
    "allow-set-ui-strings",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "allow-show-main-window"
  ]
}
