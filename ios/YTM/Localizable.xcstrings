    "YouTube Music 계정으로 쓰는 비공식 플레이어입니다. 소리는 YouTube Music 공식 플레이어가 냅니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inoffizieller Player für dein YouTube Music-Konto. Der Ton kommt vom offiziellen YouTube Music-Player."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unofficial player for your YouTube Music account. Audio comes from the official YouTube Music player."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproductor no oficial para tu cuenta de YouTube Music. El audio lo reproduce el reproductor oficial de YouTube Music."
