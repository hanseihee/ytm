    "곡을 재생하면 다음에 나올 곡이 여기에 쌓입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende Songs erscheinen hier, sobald etwas läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upcoming songs appear here when you play something."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las próximas canciones aparecerán aquí al reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres à venir s’affichent ici pendant la lecture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagu berikutnya muncul di sini saat ada yang diputar."
          }
