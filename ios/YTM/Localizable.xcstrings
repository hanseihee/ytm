          }
        }
      }
    },
    "곡 옆 메뉴에서 \"좋아요\"를 누르면 여기에 모입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe im Song-Menü auf „Gefällt mir“, um ihn hier zu sammeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Like” in a song’s menu to collect it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Me gusta» en el menú de una canción para guardarla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « J’aime » dans le menu d’un titre pour le retrouver ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk “Suka” di menu lagu untuk mengumpulkannya di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲のメニューで「高評価」を押すとここに集まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Curtir” no menu da música para reuni-la aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在歌曲菜单中点按“喜欢”，歌曲就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在歌曲選單中點按「喜歡」，歌曲就會出現在這裡。"
          }
        }
      }
    },
    "곡을 재생하면 가사가 여기에 나옵니다" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Songtext erscheint hier beim Abspielen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyrics appear here when a song plays"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La letra aparecerá aquí al reproducir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles s’affichent ici pendant la lecture"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lirik muncul di sini saat lagu diputar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲を再生すると歌詞がここに表示されます"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letra aparece aqui quando a música toca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放歌曲后歌词会显示在这里"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放歌曲後歌詞會顯示在這裡"
          }
        }
      }
    },
