    "%@ 삭제합니다. 내가 만든 플레이리스트만 삭제할 수 있고, 되돌릴 수 없습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird gelöscht. Du kannst nur eigene Playlists löschen, und das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be deleted. You can only delete playlists you created, and this can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará %@. Solo puedes eliminar las playlists que creaste y no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimée. Vous ne pouvez supprimer que vos propres playlists, et c’est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan dihapus. Hanya playlist buatan Anda yang bisa dihapus, dan ini tidak bisa dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除します。削除できるのは自分で作成したプレイリストのみで、元に戻せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será excluída. Só é possível excluir playlists criadas por você, e isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除 %@。只能删除你创建的播放列表，且无法撤消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除 %@。只能刪除你建立的播放清單，且無法復原。"
          }
        }
      }
    },
