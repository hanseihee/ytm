    "곡 메뉴에서 \"플레이리스트에 추가\"를 고르세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle im Song-Menü „Zu Playlist hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose “Add to playlist” from a song’s menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Añadir a playlist» en el menú de una canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Ajouter à une playlist » dans le menu d’un titre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih “Tambahkan ke playlist” di menu lagu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲のメニューから「プレイリストに追加」を選んでください。"
          }
        },
        "pt-BR" : {
